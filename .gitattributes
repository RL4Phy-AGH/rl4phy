# Shell scripts must stay LF: they are copied into Linux images,
# and a CRLF shebang breaks the container entrypoint on Windows checkouts.
*.sh text eol=lf

# Generated by grpc_tools.protoc from proto/rl4phy.proto and committed, so a
# checkout and CI see the same imports. Not written by hand.
python/rl4phy_pb2.py linguist-generated=true
python/rl4phy_pb2_grpc.py linguist-generated=true
