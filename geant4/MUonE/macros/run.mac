/gps/particle mu-
/gps/ene/type Mono
/gps/ene/mono 160 GeV
/gps/pos/type Beam
/gps/pos/centre 0 0 -50 cm
/gps/pos/sigma_r 2 mm
/gps/ang/type beam1d
/gps/ang/sigma_x 0.3 mrad
/gps/ang/sigma_y 0.3 mrad
# GPS emits along -z by default; rotate the angular frame to fire +z through the stations
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 -1 0
/run/beamOn 1
